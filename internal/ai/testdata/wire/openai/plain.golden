05 keepalive served="gpt-4.1-2025-04-14"
06 keepalive served="gpt-4.1-2025-04-14"
07 done finish="stop" in=1290 out=18 cacheRead=1024 served="gpt-4.1-2025-04-14"
return nil
summary chunks=7 keepalives=3 text="The flow reads the workbook, then loops over each row — café names included."
