# gemini/plain.sse through parseGeminiSSE (go test ./internal/ai/ -run TestWireGolden -update-wire)
# one line per chunk; then the parser's return; errors by class (the sentinel) and provider message, not wrapping prose
01 text="The flow reads " served="gemini-2.5-flash"
02 text="the workbook, then loops " served="gemini-2.5-flash"
