    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.0",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "i18next": "^26.5.4",
    "lucide-react": "^1.61.0",
    "prism-react-renderer": "^2.4.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
