{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pad-analyzer",
  "version": "0.1.0",
  "identifier": "com.baki.pad-analyzer",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "title": "PAD Analyzer",
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/pad-backend"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "pad"],
        "name": "PAD Flow Export",
        "description": "Power Automate Desktop Flow Export",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
