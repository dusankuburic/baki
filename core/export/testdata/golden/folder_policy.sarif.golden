                "level": "note"
              },
              "properties": {
                "category": "Portability",
                "confidence": "low"
              }
            },
            {
              "id": "missing-delay",
              "name": "Web action without wait",
              "shortDescription": {
                "text": "Web action without wait"
              },
              "fullDescription": {
                "text": "Two consecutive WebAutomation/UIAutomation actions with no wait between them."
              },
              "help": {
                "text": "Two consecutive WebAutomation/UIAutomation actions with no wait between them.\n\nAuto-fix available: insert-delay (apply with `bakicli fix`).\n\nRun `bakicli rules missing-delay` for the full rule description.",
                "markdown": "Two consecutive WebAutomation/UIAutomation actions with no wait between them.\n\nAuto-fix available: insert-delay (apply with `bakicli fix`).\n\nRun `bakicli rules missing-delay` for the full rule description."
              },
              "helpUri": "https://github.com/dusankuburic/baki#features",
              "defaultConfiguration": {
