                  "kind": "member"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "padFindingId/v1": "2b5a2e2c882ca784"
          }
        },
        {
          "ruleId": "unhandled-error",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "This action can fail at runtime.\n\nSuggestion: Wrap it in ON BLOCK ERROR."
          },
          "locations": [
