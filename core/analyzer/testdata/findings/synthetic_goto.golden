# Analysis golden (core/analyzer/findings_golden_test.go). Blocks are <subflow>#<pre-order index>.
# Later variants print "as default" plus severity changes when only severities differ; otherwise they
# show title/desc/meta only for findings whose content differs from every default finding.
input: synthetic_goto
document: subflows=1 blocks=12 parseErrors=0 folder=false

=== default
stats: {"errors":0,"warnings":0,"info":1,"blocksAnalyzed":12,"rulesRun":45,"rulesSkipped":0,"suppressed":0}
progress: events=11 final=540/540 last="Loop body is too large"
metrics: {"avgCognitive":0,"avgCyclomatic":1,"healthScore":99,"maxCognitive":0,"maxCyclomatic":1,"subflowCount":1,"totalBlocks":12,"totalVariables":0,"variableDensity":0} circular=[]
  subflow Main: {"blockCount":12,"cognitiveComplexity":0,"cyclomaticComplexity":1,"fanIn":0,"fanOut":0,"maxNestingDepth":0,"variableCount":0}
profiles: rules=45 order=c60dd8f9183dbce7 blocksChecked=12
  raw findings: subflow-no-error-handler=1
inventory: none
findings: 1
F-001 info/medium subflow-no-error-handler [Reliability] fix=wrap-error-handler @Main#0 sf=Main fp=subflow-no-error-handler:3b84c8a647001302
    title: Subflow without error handler
    desc: Subflow "Main" has action blocks but no error handler. Unhandled errors will silently terminate the subflow.

