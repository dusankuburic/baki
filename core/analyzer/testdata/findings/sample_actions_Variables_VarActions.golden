# Analysis golden (core/analyzer/findings_golden_test.go). Blocks are <subflow>#<pre-order index>.
# Later variants print "as default" plus severity changes when only severities differ; otherwise they
# show title/desc/meta only for findings whose content differs from every default finding.
input: sample_actions_Variables_VarActions
document: subflows=1 blocks=21 parseErrors=0 folder=false

=== default
