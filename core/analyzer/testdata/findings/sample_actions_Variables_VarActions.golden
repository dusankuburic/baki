profiles: rules=45 order=c60dd8f9183dbce7 blocksChecked=20
  raw findings: empty-handler=1 error-swallow=1 unused-variable=1
inventory: none
findings: 3
F-001 warning/high empty-handler [Reliability] fix=insert-handler-log @VarActions#5 sf=VarActions fp=empty-handler:8eb8a5e57b911b0c
    title: Error handler is empty
    desc: This error handler has no actions inside it, so errors will be silently ignored.
F-002 warning/medium error-swallow [Reliability] fix=insert-error-log @VarActions#5 sf=VarActions fp=error-swallow:8eb8a5e57b911b0c
    title: Error handler swallows errors silently
    desc: This error handler catches errors but doesn't appear to log them, set error variables, or take any meaningful action.
F-003 info/low unused-variable [Style] fix=remove-block @VarActions#18 sf=VarActions fp=unused-variable:84e393db42103653
    title: Variable declared but never used
    desc: This variable is set but never referenced elsewhere in the flow.
    meta: {"variable":"num"}

