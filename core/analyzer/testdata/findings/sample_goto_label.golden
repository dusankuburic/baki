# Analysis golden (core/analyzer/findings_golden_test.go). Blocks are <subflow>#<pre-order index>.
# Later variants print "as default" plus severity changes when only severities differ; otherwise they
# show title/desc/meta only for findings whose content differs from every default finding.
input: sample_goto_label
document: subflows=1 blocks=10 parseErrors=0 folder=false

=== default
stats: {"errors":0,"warnings":1,"info":1,"blocksAnalyzed":9,"rulesRun":45,"rulesSkipped":0,"suppressed":0}
progress: events=9 final=405/405 last="Loop body is too large"
metrics: {"avgCognitive":1,"avgCyclomatic":2,"healthScore":95,"maxCognitive":1,"maxCyclomatic":2,"subflowCount":1,"totalBlocks":9,"totalVariables":0,"variableDensity":0} circular=[]
  subflow Main: {"blockCount":9,"cognitiveComplexity":1,"cyclomaticComplexity":2,"fanIn":0,"fanOut":0,"maxNestingDepth":1,"variableCount":0}
profiles: rules=45 order=c60dd8f9183dbce7 blocksChecked=9
  raw findings: goto-antipattern=1 subflow-no-error-handler=1
inventory: none
findings: 2
F-001 warning/medium goto-antipattern [Logic] fix=- @Main#4 sf=Main fp=goto-antipattern:2a92d3cc149cdb8a
    title: GOTO breaks scope boundary
    desc: This GOTO jumps to a label outside its current scope (across loop/condition/switch boundaries), which creates fragile and hard-to-maintain control flow.
    meta: {"targetLabel":"Start"}
F-002 info/medium subflow-no-error-handler [Reliability] fix=wrap-error-handler @Main#0 sf=Main fp=subflow-no-error-handler:2628d5beb13d645c
    title: Subflow without error handler
    desc: Subflow "Main" has action blocks but no error handler. Unhandled errors will silently terminate the subflow.

