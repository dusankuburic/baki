# Deployment mode: "local" (Tauri desktop) or "cloud" (web server)
PAD_MODE=cloud

# HTTP server bind address and port (cloud mode)
PAD_HOST=0.0.0.0
PAD_PORT=8080

# Comma-separated list of allowed CORS / WebSocket origins (cloud mode)
# Example: https://app.example.com,https://staging.example.com
PAD_ALLOWED_ORIGINS=https://app.example.com

# JWT signing secret — required in cloud mode; must be a long random string
PAD_AUTH_SECRET=change-me-to-a-long-random-secret

# Storage backend: "local" (filesystem) or "database" (PostgreSQL)
PAD_STORAGE_BACKEND=database

# PostgreSQL connection string (required when PAD_STORAGE_BACKEND=database)
PAD_DATABASE_DSN=postgres://user:password@localhost:5432/baki?sslmode=require

# Local data directory (local mode only)
# PAD_DATA_DIR=/home/user/.local/share/pad-analyzer
